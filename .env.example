# Copia este archivo a .env.local y llena los valores reales.
# .env.local nunca se sube al repositorio (ver .gitignore).

NEXT_PUBLIC_SUPABASE_URL=

# Clave pública (anon). Las tablas tienen RLS sin policies para este rol:
# solo se usa para el inicio de sesión del navegador de salud, nunca para
# leer/escribir datos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service Role Key. SOLO en código de servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
